# Copia este archivo como .env y completa los valores.

# --- IA (Gemini, capa gratuita) ---
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini            # gemini | fake (fake = solo pruebas, sin API)
EMBEDDING_MODEL=models/gemini-embedding-001

# --- RAG ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHROMA_PATH=./.chroma

# --- Calidad ---
UMBRAL_FIDELIDAD=0.85
MAX_REINTENTOS=2

# --- Límites ---
MAX_ARCHIVOS=5
MAX_MB=20
MAX_PAGINAS=200
MAX_CHUNKS=400
MAX_TAREAS=2

# --- Frontend permitido (CORS) ---
CORS_ORIGINS=http://localhost:5173

# --- OCI Object Storage (Always Free). OBLIGATORIO para la entrega ---
OCI_ENABLED=false                    # true para usar OCI
OCI_BUCKET=krystal-contenidos-educativos
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_NAMESPACE=                       # opcional; si se deja vacío se consulta a OCI
LOCAL_STORE=./.local_store           # solo desarrollo, cuando OCI_ENABLED=false