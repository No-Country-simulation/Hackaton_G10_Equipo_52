# Copia este archivo como .env.local (no se sube al repositorio) y ajusta los valores.

# Modo demo: true = respuestas simuladas, false = backend real.
# Si no se define: true con "npm run dev" y false en el build de producción.
VITE_USE_DEMO=true

# URL del backend, sin barra final.
# En desarrollo, si no se define, se usa http://localhost:8000.
# En producción es obligatoria: puede ir vacía (mismo origen), pero tiene que estar definida.
VITE_API_URL=http://localhost:8000